rules_version = '2';
// Fairway Tales rules (version 1.1).
//   fd_<date>_<pad|3>/<playerId>     daily challenge, one go per player per day
//   fc_<course>/<playerId>           best round on each course, can only improve
//   fa/<playerId>_<hole>             holes in one, one per player per hole
//   rooms/<CODE>                     live rooms: up to 4 players, each writes only their own line, open for a day
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(id) {
      return request.auth != null && id == request.auth.uid;
    }
    function nameOk(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.title is string && d.title.size() <= 30
        && d.at is timestamp;
    }

    match /{board}/{player} {
      allow read: if board.matches('fd_[0-9]{4}-[0-9]{2}-[0-9]{2}_(pad|3)')
        || board.matches('fc_(ashby|links|mesa|frost|sky)');

      // Daily challenge: created once, never changed.
      allow create: if board.matches('fd_[0-9]{4}-[0-9]{2}-[0-9]{2}_(pad|3)')
        && signedIn(player)
        && request.resource.data.keys().hasOnly(['name', 'title', 'fmt', 's', 'at'])
        && nameOk(request.resource.data)
        && request.resource.data.s is int
        && ((request.resource.data.fmt == 'ctp'   && request.resource.data.s >= 0 && request.resource.data.s <= 99)
         || (request.resource.data.fmt == 'long'  && request.resource.data.s >= 0 && request.resource.data.s <= 400)
         || (request.resource.data.fmt == 'chip'  && request.resource.data.s >= 0 && request.resource.data.s <= 300)
         || (request.resource.data.fmt == 'putts' && request.resource.data.s >= 6 && request.resource.data.s <= 30));

      // Best rounds: 9 holes, and an update has to beat the old score.
      allow create, update: if board.matches('fc_(ashby|links|mesa|frost|sky)')
        && signedIn(player)
        && request.resource.data.keys().hasOnly(['name', 'title', 's', 'rel', 'at'])
        && nameOk(request.resource.data)
        && request.resource.data.s is int && request.resource.data.s >= 9 && request.resource.data.s <= 120
        && request.resource.data.rel is int && request.resource.data.rel >= -27 && request.resource.data.rel <= 84
        && (resource == null || request.resource.data.s < resource.data.s);
    }

    // Holes in one: created once per player per hole.
    match /fa/{entry} {
      allow read: if true;
      allow create: if request.auth != null
        && entry.matches(request.auth.uid + '_[a-z0-9]{1,8}')
        && request.resource.data.keys().hasOnly(['name', 'title', 'course', 'hole', 'holeName', 'at'])
        && nameOk(request.resource.data)
        && request.resource.data.course is string && request.resource.data.course.size() <= 30
        && request.resource.data.holeName is string && request.resource.data.holeName.size() <= 30
        && request.resource.data.hole is int && request.resource.data.hole >= 1 && request.resource.data.hole <= 18;
    }

    // Live rooms. You can only open a room if you know its code (no listing), you can only
    // write your own line, only the host can start or end the round, and rooms close after a day.
    match /rooms/{code} {
      function me() {
        return 'p_' + request.auth.uid;
      }
      function lineOk(p) {
        return p is map
          && p.keys().hasOnly(['n', 't', 'sc', 'h', 'd', 'at'])
          && p.n is string && p.n.size() > 0 && p.n.size() <= 20
          && p.t is string && p.t.size() <= 30
          && p.sc is string && p.sc.size() <= 40
          && p.h is int && p.h >= 0 && p.h <= 9
          && p.d is bool
          && p.at is timestamp;
      }

      allow get: if request.auth != null;
      allow list, delete: if false;

      allow create: if request.auth != null
        && code.matches('[A-HJ-NP-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'course', 'seed', 'g', 'state', 'at', 'ver', me()])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.hostName is string && request.resource.data.hostName.size() > 0 && request.resource.data.hostName.size() <= 20
        && request.resource.data.course in ['ashby', 'links', 'mesa', 'frost', 'sky']
        && request.resource.data.seed is int
        && request.resource.data.g in ['own', 'club']
        && request.resource.data.state == 'lobby'
        && request.resource.data.at is timestamp
        && request.resource.data.at > request.time - duration.value(1, 'h')
        && request.resource.data.at < request.time + duration.value(1, 'h')
        && request.resource.data.ver == 1
        && lineOk(request.resource.data[me()]);

      allow update: if request.auth != null
        && request.time < resource.data.at + duration.value(1, 'd')
        && (
          // a player joins, or updates their own scores
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([me()])
            && lineOk(request.resource.data[me()])
            && request.resource.data.keys().size() <= 12
            && (me() in resource.data || resource.data.state != 'done'))
          ||
          // the host starts or ends the round
          (request.auth.uid == resource.data.host
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
            && request.resource.data.state in ['play', 'done'])
        );
    }
  }
}
